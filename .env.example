# Analizcim - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun: cp .env.example .env

# Sunucu portu (varsayılan: 3000)
PORT=3000

# Oturum güvenliği - production'da mutlaka güçlü ve rastgele bir değer kullanın
SESSION_SECRET=buraya-guclu-rastgele-bir-anahtar-yazin

# Opsiyonel: production ortamı (cookie secure için)
# NODE_ENV=production

# Log seviyesi (varsayılan: info). Örnekler: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Oturum zaman aşımı (milisaniye cinsinden)
# Örnekler: 3600000 = 1 saat, 86400000 = 24 saat (varsayılan), 604800000 = 7 gün
SESSION_TIMEOUT=86400000

# Rate Limiting - API istek sınırlaması
# Rate limit penceresi (milisaniye cinsinden, varsayılan: 900000 = 15 dakika)
# RATE_LIMIT_WINDOW=900000

# Genel API istek sınırı (varsayılan: 100 istek per window)
# RATE_LIMIT_MAX=100

# Auth endpoint istek sınırı (varsayılan: 10 istek per window)
# AUTH_RATE_LIMIT_MAX=10

# Login istek sınırı (varsayılan: 5 istek per window - brute force koruması için)
# LOGIN_RATE_LIMIT_MAX=5
