# Analizcim - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun: cp .env.example .env
# ÖNEMLİ: Bu bir ŞABLONDUR. Gerçek sırları buraya YAZMAYIN; yalnızca .env dosyanıza yazın.

# Sunucunun dinleyeceği host (varsayılan: tüm arayüzler). Lokal/güvenli çalışma için: 127.0.0.1
# HOST=127.0.0.1

# Sunucu portu (varsayılan: 3000)
PORT=3000

# Oturum güvenliği - PRODUCTION'DA MUTLAKA güçlü ve rastgele bir değer kullanın.
# Üretmek için örn: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=buraya-guclu-rastgele-bir-anahtar-yazin

# Opsiyonel: production ortamı (cookie secure için)
# NODE_ENV=production

# Log seviyesi (varsayılan: info). Örnekler: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Oturum zaman aşımı (milisaniye cinsinden)
# Örnekler: 3600000 = 1 saat, 86400000 = 24 saat (varsayılan), 604800000 = 7 gün
SESSION_TIMEOUT=86400000

# Rate Limiting - API istek sınırlaması
# Rate limit penceresi (milisaniye cinsinden, varsayılan: 900000 = 15 dakika)
# RATE_LIMIT_WINDOW=900000

# Genel API istek sınırı (varsayılan: 1500 istek / pencere)
# RATE_LIMIT_MAX=1500

# Auth endpoint istek sınırı (varsayılan: 60 istek / pencere)
# AUTH_RATE_LIMIT_MAX=60

# Login istek sınırı (varsayılan: 10 başarısız deneme / pencere - kaba kuvvet koruması)
# LOGIN_RATE_LIMIT_MAX=10

# --- İlk Admin (bootstrap) ---
# Uygulama ilk çalıştırıldığında admin hesabı yoksa, bu değişkenlerle bir admin oluşturulur.
# Kendi güçlü kullanıcı adı/parolanızı girin (aşağıdakiler yalnızca örnektir).
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=degistir-guclu-bir-parola

# --- Test / QA (yalnızca güvenli lokal test için) ---
# Testlerin gerçek veritabanı yerine kullanacağı geçici DB yolu.
# TEST_DATABASE_PATH=/private/tmp/analizcim-test.db
