{
  "name": "analizcim",
  "version": "1.0.0",
  "description": "Lokal Excel satış/alış analiz uygulaması",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ademtfkc/analizcim.git"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "NODE_ENV=test node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "NODE_ENV=test node --test --test-force-exit \"tests/integration/**/*.test.js\"",
    "test:coverage": "c8 node --test \"tests/**/*.test.js\"",
    "test:smoke": "NODE_ENV=test node --test tests/smoke-tabs.test.js",
    "test:ci": "NODE_ENV=test node --test --test-force-exit \"tests/unit/**/*.test.js\"",
    "smoke": "node scripts/smoke_tabs.js",
    "verify": "npm run lint && npm run test:unit && npm run test:integration && npm run test:smoke",
    "verify:fast": "npm run lint && npm run test:unit && npm run test:smoke",
    "start": "node src/server.js",
    "lint": "eslint src tests"
  },
  "keywords": [
    "excel",
    "analiz",
    "satis",
    "alis"
  ],
  "author": "Adem Gökhan Tüfekci",
  "license": "ISC",
  "dependencies": {
    "arima": "^0.2.8",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "c8": "^10.0.0",
    "eslint": "^8.57.0"
  }
}
